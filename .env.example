# Public Firebase web configuration — safe to expose client-side.
# Access control is enforced by Realtime Database rules, not by these values.
# Copy this file to `.env` and fill in the values from:
# Firebase console → Project settings → Your apps → Web app → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: max tolerated video drift (seconds) before clients re-seek.
# Lower = tighter sync but more seeks. Default: 0.75
VITE_SYNC_DRIFT_TOLERANCE_SEC=0.75

# Set to "true" ONLY for local development against the Firebase Emulator
# Suite (auth :9099, database :9000). MUST stay unset/false in production.
VITE_USE_FIREBASE_EMULATORS=false
